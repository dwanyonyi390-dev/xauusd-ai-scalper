# =============================================================================
# XAUUSD-AI-SCALPER — environment example
# Copy to .env and fill in. NEVER commit .env.
# =============================================================================

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
PORT=10000
LOG_LEVEL=info

# --- AI ----------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Telegram ----------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_ID=

# --- MongoDB Atlas -----------------------------------------------------------
MONGODB_URI=

# --- MT5 Agent (EA ↔ Render HMAC) -------------------------------------------
MT5_AGENT_ID=
MT5_AGENT_SECRET=
MT5_API_SECRET=

# --- Trading defaults --------------------------------------------------------
TRADING_SYMBOL=XAUUSD
TRADING_MODE=DEMO

DEFAULT_MAX_POSITIONS=4
DEFAULT_LOT_SIZE=0.01
DEFAULT_PROFIT_TARGET=0.50
DEFAULT_RISK_PERCENT=0.5
DEFAULT_MAX_DAILY_LOSS=2
DEFAULT_MAX_HOLD_SECONDS=60
DEFAULT_MAX_SPREAD=
DEFAULT_MAX_CONSECUTIVE_LOSSES=3

# --- News / Economic calendar (optional) ------------------------------------
NEWS_API_KEY=
ECONOMIC_CALENDAR_API_KEY=